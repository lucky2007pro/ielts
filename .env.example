# Google Gemini API kaliti (Ixtiyoriy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Python FastAPI backend manzili (Render da avtomatik ulanadi)
BACKEND_URL=http://127.0.0.1:8000

# Google OAuth 2.0 (Google Cloud Console -> Credentials)
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
# va Render uchun: https://sizning-frontend-domeningiz.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
AUTH_SECRET=random_long_secret_string_change_this
